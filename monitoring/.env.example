# Copie a placer dans /opt/nookapp-monitoring/.env sur le VPS.
GRAFANA_ADMIN_PASSWORD=change-me
GRAFANA_DOMAIN=grafana.nookapp.eu
# Webhook du canal Discord qui recoit les alertes Grafana.
DISCORD_ALERT_WEBHOOK=https://discord.com/api/webhooks/xxx/yyy
# Reseaux Docker des stacks applicatives supervisees (scrape api + postgres).
STAGING_NETWORK=nookapp-staging_default
PROD_NETWORK=nookapp-prod_default
# DSN lus par les postgres-exporter (host "postgres" = alias dans chaque stack).
MONITORING_DATABASE_URL_STAGING=postgresql://nookapp:change-me@postgres:5432/nookapp?sslmode=disable
MONITORING_DATABASE_URL_PROD=postgresql://nookapp:change-me@postgres:5432/nookapp?sslmode=disable
